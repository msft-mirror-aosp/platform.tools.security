package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_fuzz {
    name: "libffi_fuzz",
    defaults: [
        "no_bti",
    ],
    host_supported: true,
    srcs: [
        "fuzz_ffi.cc",
    ],
    include_dirs: [
        "external/libffi",
    ],
    cflags: [
        "-Wno-macro-redefined",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    static_libs: [
        "libffi",
    ],
    fuzz_config: {
        description: "The fuzzer targets the APIs of libffi",
        vector: "local_no_privileges_required",
        service_privilege: "privileged",
        users: "multi_user",
        fuzzed_code_usage: "shipped",
    },
}
