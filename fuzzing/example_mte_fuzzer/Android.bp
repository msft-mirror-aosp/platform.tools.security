package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_platform_security",
}

cc_fuzz {
    name: "example_mte_fuzzer",
    srcs: [
        "example_mte_fuzzer.cpp",
    ],

    fuzz_config: {
        description: "Test Fuzzer",
        production_date: "10/7/2025",
        critical: false,
        fuzz_on_haiku_device: true,
        fuzz_on_haiku_host: false,
        vector: "local_no_privileges_required",
        service_privilege: "nsi",
        users: "multi_user",
        fuzzed_code_usage: "experimental",
    },
}
